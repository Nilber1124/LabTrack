@model FormularioEquipoViewModel
@{
    ViewData["Title"] = Model.EsNuevo ? "Nuevo equipo" : "Editar equipo";
}
@section Styles {
    <link rel="stylesheet" href="~/css/equipos.css" asp-append-version="true" />
}
<h1>@ViewData["Title"]</h1>
<form asp-action="Guardar" method="post" enctype="multipart/form-data" class="formulario equipo-formulario">
    <partial name="_CamposEquipo" model="Model" />
    <div class="acciones">
        <a class="btn btn-secundario" asp-action="Index">Cancelar</a>
        <button type="submit" class="btn btn-primario">Guardar equipo</button>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/equipos.js" asp-append-version="true"></script>
}
