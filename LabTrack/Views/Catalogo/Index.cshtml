@model CatalogoViewModel
@{
    ViewData["Title"] = "Catálogo";
    string? Actual(string? nombre) => Model.CategoriaSeleccionada == nombre ? "true" : null;
}
@section Styles {
    <link rel="stylesheet" href="~/css/catalogo.css" asp-append-version="true" />
}
<div class="encabezado">
    <div>
        <h1>Catálogo de equipos</h1>
        <span class="ayuda">@Model.Paginacion.Total equipos · @Model.TotalDisponibles disponibles ahora</span>
    </div>
</div>

<div class="filtros">
    <span class="filtros-titulo">Categoría</span>
    <div class="segmentos">
        <a asp-action="Index" aria-current="@Actual(null)">Todas · @Model.TotalGeneral</a>
        @foreach (var categoria in Model.Categorias)
        {
            <a asp-action="Index" asp-route-categoria="@categoria.Nombre" aria-current="@Actual(categoria.Nombre)">@categoria.Nombre · @categoria.Total</a>
        }
    </div>
</div>

@if (Model.SinResultados)
{
    <div class="vacio" role="status">
        <b>@Model.MensajeVacio</b>
        <span class="ayuda">Prueba con otra categoría o vuelve más tarde.</span>
        <a class="btn btn-secundario" asp-action="Index">Ver todas las categorías</a>
    </div>
}
else
{
    <div class="tarjetas">
        @foreach (var equipo in Model.Equipos)
        {
            var disponible = equipo.Estado == EstadoEquipo.Disponible;
            <article class="tarjeta">
                <div class="tarjeta-cabecera">
                    <span class="filtros-titulo">@equipo.Categoria</span>
                    <partial name="_Badge" model="@(disponible ? "disponible" : "prestado")" />
                </div>
                <h2 class="tarjeta-nombre">@equipo.Nombre</h2>
                <div class="codigo">Inv. @equipo.CodigoInventario</div>
                @if (disponible)
                {
                    <a class="btn btn-primario tarjeta-accion" asp-controller="Reservas" asp-action="Crear" asp-route-idEquipo="@equipo.IdEquipo">Reservar<span aria-hidden="true">→</span></a>
                }
                else
                {
                    <button type="button" class="btn btn-secundario tarjeta-accion" disabled>No disponible · hasta @Formato.Hora(equipo.PrestadoHasta!.Value)</button>
                }
            </article>
        }
    </div>
    <partial name="_Paginacion" model="Model.Paginacion" />
}
