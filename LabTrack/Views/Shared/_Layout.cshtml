@using LabTrack.Reglas
@{
    var controlador = ViewContext.RouteData.Values["controller"] as string;
    var esEncargado = User.IsInRole(NombresRol.Encargado);
    var esEstudiante = User.IsInRole(NombresRol.Estudiante);
    // Reservar un equipo forma parte del recorrido del catálogo.
    var seccion = ViewContext.RouteData.Values["action"] as string == "Crear" ? "Catalogo" : controlador;
    string? Actual(string nombre) => seccion == nombre ? "page" : null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · LabTrack</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="barra">
        <span class="marca"><img class="marca-logo" src="~/images/logo.png" alt="" />LabTrack</span>
        <nav class="barra-nav" aria-label="Navegación principal">
            @if (esEstudiante)
            {
                <a asp-controller="Catalogo" asp-action="Index" aria-current="@Actual("Catalogo")">Catálogo</a>
                <a asp-controller="Reservas" asp-action="Index" aria-current="@Actual("Reservas")">Mis reservas</a>
            }
            @if (esEncargado)
            {
                <a asp-controller="Solicitudes" asp-action="Index" aria-current="@Actual("Solicitudes")">Solicitudes</a>
                <a asp-controller="Devoluciones" asp-action="Index" aria-current="@Actual("Devoluciones")">Devoluciones</a>
                <a asp-controller="Penalizados" asp-action="Index" aria-current="@Actual("Penalizados")">Penalizados</a>
            }
        </nav>
        @if (User.Identity?.IsAuthenticated == true)
        {
            @await Component.InvokeAsync("UsuarioActual")
            <form asp-controller="Login" asp-action="Salir" method="post">
                <button type="submit" class="btn btn-enlace">Salir</button>
            </form>
        }
    </header>
    <main class="contenido">
        <partial name="_Mensajes" />
        @RenderBody()
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
