@model string
@{
    // Cada estado lleva icono, texto y borde: el color nunca va solo.
    var (texto, tono, icono) = Model switch
    {
        "disponible" => ("Disponible", "ok", "M20 6 9 17l-5-5"),
        "prestado" => ("Prestado", "info", "M21 8 12 3 3 8v8l9 5 9-5ZM3.3 7 12 12l8.7-5M12 22V12"),
        "pendiente" => ("Pendiente", "warn", "M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20ZM12 6v6l4 2"),
        "aprobada" => ("Aprobada", "ok", "M20 6 9 17l-5-5"),
        "rechazada" => ("Rechazada", "err", "M18 6 6 18M6 6l12 12"),
        "devuelta" => ("Devuelta", "gray", "M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8M3 3v5h5"),
        "penalizado" => ("Penalizado", "err", "M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20ZM4.9 4.9l14.2 14.2"),
        "activa" => ("En curso", "info", "M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20ZM12 6v6l4 2"),
        "vencida" => ("Vencida", "err", "M21.73 18l-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3M12 9v4M12 17h.01"),
        "baja" => ("De baja", "gray", "M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20ZM4.9 4.9l14.2 14.2"),
        _ => (Model, "gray", "")
    };
}
<span class="badge badge-@tono">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="@icono"></path></svg>
    @texto
</span>
