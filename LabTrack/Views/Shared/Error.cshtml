@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<h1>Algo salió mal</h1>
<p>No pudimos completar tu solicitud. Inténtalo de nuevo en unos momentos.</p>
@if (Model.ShowRequestId)
{
    <p class="ayuda">Referencia: <span class="codigo">@Model.RequestId</span></p>
}
<a class="btn btn-primario" asp-controller="Login" asp-action="Index">Volver al inicio</a>
