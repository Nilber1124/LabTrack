@{
    var esVistaPrevia = ViewData["EsVistaPrevia"] is true;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · LabTrack</title>
    <link rel="stylesheet" href="~/css/solicitudes.css" asp-append-version="true" />
</head>
<body>
    <header class="panel-header">
        <a class="brand" asp-controller="Solicitudes" asp-action="Index"><span class="brand-square" aria-hidden="true"></span>LabTrack</a>
        <nav aria-label="Navegación principal">
            <a class="nav-current" asp-controller="@(esVistaPrevia ? "VistaPrevia" : "Solicitudes")" asp-action="@(esVistaPrevia ? "Solicitudes" : "Index")" aria-current="page">Solicitudes</a>
        </nav>
        <div class="account"><span class="avatar" aria-hidden="true">LT</span><span>@(User.Identity?.Name ?? "Encargado")<small>Encargado · Laboratorio</small></span></div>
    </header>
    <main id="contenido" class="panel-main">
        @RenderBody()
    </main>
    <footer class="panel-footer"><span>LabTrack</span><span>Gestión de equipos de laboratorio</span></footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
