@model RechazarSolicitudViewModel
@{
    ViewData["Title"] = "Rechazar solicitud";
}
<h1>Rechazar solicitud</h1>

@if (Model.Solicitud is { } solicitud)
{
    <dl class="resumen">
        <dt>Estudiante</dt><dd><b>@solicitud.Estudiante</b></dd>
        <dt>Equipo</dt><dd>@solicitud.Equipo · @solicitud.CodigoInventario</dd>
        <dt>Horario</dt><dd>@Formato.FechaYHorario(solicitud.Inicio, solicitud.Fin)</dd>
    </dl>
}

<form asp-action="Rechazar" method="post" class="formulario">
    <input asp-for="IdReserva" type="hidden" />
    <div class="campo">
        <label asp-for="Motivo"></label>
        <textarea asp-for="Motivo" class="entrada" maxlength="200" placeholder="Equipo en mantenimiento"></textarea>
        <span asp-validation-for="Motivo" class="error-campo"></span>
    </div>
    <div class="acciones">
        <a class="btn btn-secundario" asp-action="Index">Cancelar</a>
        <button type="submit" class="btn btn-peligro">Confirmar rechazo</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
