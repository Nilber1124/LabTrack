@{
    Layout = "_PanelLayout";
    ViewData["Title"] = "Solicitudes no disponibles";
}
<div class="breadcrumb">Encargado <span>/</span> Solicitudes</div>
<div class="page-heading"><h1>No pudimos completar la operación</h1></div>
<div class="notice notice-warning" role="alert">
    <strong>Las solicitudes no están disponibles en este momento.</strong>
    <p>Vuelve al listado para comprobar el estado de la reserva antes de repetir una acción.</p>
</div>
<a asp-action="Index" class="button button-primary">Volver a intentar</a>
