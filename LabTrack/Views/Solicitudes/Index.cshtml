@model SolicitudesViewModel
@{
    ViewData["Title"] = "Solicitudes";
}
<div class="encabezado">
    <div>
        <h1>Solicitudes pendientes</h1>
        <span class="ayuda">@Model.Paginacion.Total por revisar</span>
    </div>
</div>

@if (Model.Solicitudes.Count == 0)
{
    <div class="vacio" role="status">
        <b>No hay solicitudes pendientes</b>
        <span class="ayuda">Todo al día. Las nuevas aparecerán aquí.</span>
    </div>
}
else
{
    <table class="tabla">
        <thead>
            <tr><th scope="col">Estudiante</th><th scope="col">Equipo</th><th scope="col">Fecha</th><th scope="col">Hora solicitada</th><th scope="col">Acciones</th></tr>
        </thead>
        <tbody>
            @foreach (var solicitud in Model.Solicitudes)
            {
                var horario = Formato.FechaYHorario(solicitud.Inicio, solicitud.Fin);
                <tr data-id="@solicitud.IdReserva" data-estudiante="@solicitud.Estudiante"
                    data-equipo="@solicitud.Equipo · @solicitud.CodigoInventario" data-horario="@horario">
                    <td data-etiqueta="Estudiante"><b>@solicitud.Estudiante</b><small>@solicitud.CodigoEstudiante</small></td>
                    <td data-etiqueta="Equipo">@solicitud.Equipo<small>@solicitud.CodigoInventario</small></td>
                    <td data-etiqueta="Fecha">@Formato.Fecha(solicitud.Inicio)</td>
                    <td data-etiqueta="Hora solicitada">@Formato.Horario(solicitud.Inicio, solicitud.Fin)</td>
                    <td>
                        <div class="acciones">
                            <form asp-action="Aprobar" method="post" class="js-aprobar">
                                <input type="hidden" name="id" value="@solicitud.IdReserva" />
                                <button type="submit" class="btn btn-primario">Aprobar</button>
                            </form>
                            <a asp-action="Rechazar" asp-route-id="@solicitud.IdReserva" class="btn btn-peligro js-rechazar">Rechazar</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <partial name="_Paginacion" model="Model.Paginacion" />
}

<dialog id="modal-aprobar" class="modal" aria-labelledby="aprobar-titulo">
    <h2 id="aprobar-titulo">¿Aprobar esta reserva?</h2>
    <p data-resumen></p>
    <p class="modal-horario" data-horario></p>
    <p>
        Al aprobar:
        <partial name="_Badge" model="@("pendiente")" /> →
        <partial name="_Badge" model="@("aprobada")" />
        y el equipo figurará <partial name="_Badge" model="@("prestado")" /> en ese horario.
    </p>
    <div class="modal-acciones">
        <button type="button" class="btn btn-secundario" data-cerrar autofocus>Cancelar</button>
        <button type="button" class="btn btn-primario" id="confirmar-aprobar">Sí, aprobar</button>
    </div>
</dialog>

<dialog id="modal-rechazar" class="modal" aria-labelledby="rechazar-titulo">
    <form asp-action="Rechazar" method="post" class="formulario" id="form-rechazar">
        <div>
            <h2 id="rechazar-titulo">Rechazar solicitud</h2>
            <p data-resumen></p>
            <p class="modal-horario" data-horario></p>
        </div>
        <input type="hidden" name="IdReserva" id="rechazo-id" />
        <div class="campo">
            <label for="rechazo-motivo">Motivo del rechazo (obligatorio)</label>
            <textarea id="rechazo-motivo" name="Motivo" class="entrada" maxlength="200" required placeholder="Equipo en mantenimiento"></textarea>
            <span class="ayuda"><span id="rechazo-ayuda">Escribe un motivo para habilitar «Confirmar rechazo».</span> <span id="rechazo-contador">0 / 200</span></span>
        </div>
        <div class="modal-acciones">
            <button type="button" class="btn btn-secundario" data-cerrar>Cancelar</button>
            <button type="submit" class="btn btn-peligro" id="confirmar-rechazo" disabled>Confirmar rechazo</button>
        </div>
    </form>
</dialog>

@section Scripts {
    <script src="~/js/solicitudes.js" asp-append-version="true"></script>
}
